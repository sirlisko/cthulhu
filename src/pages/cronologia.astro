---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { toRoman, longDate } from '../lib/format';

const sessions = (await getCollection('sessions')).sort((a, b) => a.data.numero - b.data.numero);
---
<BaseLayout title="Cronologia" description="La cronologia della campagna: le sessioni in ordine, con date e titoli, per ripercorrere le indagini dall'inizio alla fine.">
  <h1 class="page-title">Cronologia</h1>
  <p class="page-lede">La storia della campagna in ordine, capitolo dopo capitolo.</p>

  <ol class="timeline">
    {sessions.map((s) => (
      <li class="timeline-item">
        <span class="timeline-marker" aria-hidden="true"></span>
        <div class="timeline-body">
          <span class="timeline-meta">Capitolo {toRoman(s.data.numero)} · {longDate(s.data.data)}</span>
          <a class="timeline-title" href={`/diario/${s.id}`}>{s.data.titolo}</a>
          {s.data.estratto && <p class="timeline-excerpt">{s.data.estratto}</p>}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
