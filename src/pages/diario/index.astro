---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import { toRoman, longDate } from '../../lib/format';

const sessions = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
---
<BaseLayout title="Capitoli" description="Tutte le sessioni della campagna, dalla prima all'ultima, con il racconto di ciò che gli investigatori hanno vissuto.">
  <h1 class="page-title">Capitoli</h1>
  <p class="page-lede">Il resoconto di ogni serata di gioco, dalla più recente.</p>
  <CardGrid>
    {sessions.map((s) => (
      <Card
        href={`/diario/${s.id}`}
        title={s.data.titolo}
        excerpt={s.data.estratto}
        meta={`Capitolo ${toRoman(s.data.numero)} · ${longDate(s.data.data)}`}
      />
    ))}
  </CardGrid>
</BaseLayout>
